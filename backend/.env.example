# SavahBot backend environment variables.
# Generated from app/config.py by scripts/gen_env_example.py. Do not edit by hand.
# Copy to .env for local use, or paste into Railway > Variables.
#
# Every line already holds the default, so the file works as it is.
# Lines that say edit-me are the ones only you can fill in; the app ignores edit-me, so leaving it is harmless.
# A few lines are blank on purpose; the comment above each says why.


# ======================================================================
# App
# ======================================================================
# Display name used in the dashboard and Telegram messages.
APP_NAME=SavahBot

# 'production' or 'development'.
APP_ENV=production

# Python log level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Public HTTPS URL of this backend, e.g. https://savahbot.up.railway.app. Needed for the Telegram webhook and the Google OAuth redirect. Falls back to RAILWAY_PUBLIC_DOMAIN.
# (you must edit this)
PUBLIC_BASE_URL=edit-me

# Injected automatically by Railway. Leave empty.
# (blank on purpose: Railway sets this itself)
RAILWAY_PUBLIC_DOMAIN=

# Public URL of the Vercel dashboard. Added to the CORS allow-list.
# (you must edit this)
FRONTEND_URL=edit-me

# Extra allowed browser origins, comma separated.
# (blank on purpose: only needed for extra dashboard addresses; FRONTEND_URL is already allowed)
CORS_ORIGINS=

# IANA timezone used to read reminder times such as 18:30 and to show local times.
OWNER_TIMEZONE=Africa/Nairobi

# Active chat source: 'demo' (simulated chat) or 'live' (YouTube). Switchable at runtime from the dashboard or Telegram.
BOT_MODE=demo

# Expose /docs and /openapi.json (interactive API docs).
API_DOCS_ENABLED=false

# Maximum simultaneous dashboard live-feed connections.
SSE_MAX_CLIENTS=10

# How many recent chat messages are kept in memory for the live view.
CHAT_BUFFER_SIZE=500

# Chat messages older than this are deleted automatically. Daily totals are kept forever, so charts still reach back further.
CHAT_RETENTION_DAYS=90

# Moderation history older than this is deleted automatically. Daily totals are kept forever.
ACTION_RETENTION_DAYS=365


# ======================================================================
# Security
# ======================================================================
# Dashboard login password. If empty, a random one is generated on first boot and printed ONCE in the server logs.
# (you must edit this)
OWNER_PASSWORD=edit-me

# Secret used to sign login tokens. If empty, a random one is generated and stored in the database.
# (blank on purpose: generated and stored automatically on first start)
JWT_SECRET=

# How long a dashboard login stays valid.
JWT_EXPIRE_HOURS=72

# Sign a dashboard session out after this many minutes without use. 0 turns the idle limit off.
SESSION_IDLE_MINUTES=1440

# After you re-confirm it is you, sensitive security actions stay unlocked for this many minutes.
SECURITY_STEP_UP_MINUTES=5

# Most dashboard sessions open at once. The least recently used is closed when this is exceeded.
SECURITY_MAX_SESSIONS=10

# How long sign-in activity and the security audit log are kept.
SECURITY_LOG_RETENTION_DAYS=365

# Passkey site id. Leave empty to use the host name of FRONTEND_URL (for example dash.example.app). Must be the dashboard's host, not the API's.
WEBAUTHN_RP_ID=

# Comma-separated dashboard origins allowed to use passkeys. Leave empty to use FRONTEND_URL.
WEBAUTHN_ORIGINS=

# Require passkeys to verify you (fingerprint, face or PIN). Turn on if every passkey you use supports it.
WEBAUTHN_REQUIRE_UV=false

# Failed logins allowed before the lockout starts.
LOGIN_MAX_ATTEMPTS=5

# How long a locked-out client must wait.
LOGIN_LOCKOUT_MINUTES=15


# ======================================================================
# Notifications (Firebase Cloud Messaging)
# ======================================================================
# Firebase project ID (Project settings > General). Needed to send push notifications.
# (you must edit this)
FIREBASE_PROJECT_ID=edit-me

# Service account e-mail (the client_email in the service-account JSON). Backend only; never shown in the dashboard.
# (you must edit this)
FIREBASE_CLIENT_EMAIL=edit-me

# Service account private key (the private_key in the JSON). Paste it with \n for line breaks. Backend only; never commit it.
# (you must edit this)
FIREBASE_PRIVATE_KEY=edit-me

# Alternative to the two lines above: the whole service-account JSON, or the same JSON base64 encoded. Backend only.
# (blank on purpose: optional: use it instead of FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase web app apiKey (Project settings > Your apps). Public by design; the dashboard needs it to receive pushes.
# (you must edit this)
FIREBASE_WEB_API_KEY=edit-me

# Firebase web app appId. Public by design.
# (you must edit this)
FIREBASE_WEB_APP_ID=edit-me

# Firebase messagingSenderId (Cloud Messaging tab). Public by design.
# (you must edit this)
FIREBASE_MESSAGING_SENDER_ID=edit-me

# Optional Firebase authDomain. Not needed for push; leave blank.
# (blank on purpose: not needed for push notifications)
FIREBASE_AUTH_DOMAIN=

# Web Push certificate public key (Cloud Messaging > Web configuration > Generate key pair). Public by design.
# (you must edit this)
FIREBASE_VAPID_KEY=edit-me

# How long the activity log is kept. 0 keeps it forever.
ACTIVITY_RETENTION_DAYS=365

# Send a notification when a sensitive change is logged, such as a security or sign-in setting.
ACTIVITY_NOTIFY_SENSITIVE=false

# Folder where voice packs for the chat reader are stored. On Railway, attach a Volume at this path or uploads are lost on redeploy.
VOICE_DIR=data/voices

# Most megabytes of voice files you can keep. Uploads that would pass this are refused.
VOICE_PACK_MAX_MB=300

# Notification history older than this is deleted automatically.
NOTIFY_RETENTION_DAYS=30

# Most push messages sent per hour. Extras are folded into one summary.
NOTIFY_MAX_PUSH_PER_HOUR=30

# Times a failed push is retried (with growing delays) before it is marked failed.
NOTIFY_MAX_ATTEMPTS=5


# ======================================================================
# Weather (Open-Meteo)
# ======================================================================
# Only if you have bought an Open-Meteo commercial plan: its API key. Leave blank for the free, non-commercial service (no key needed).
# (blank on purpose: only for a paid Open-Meteo plan; the free service needs no key)
WEATHER_COMMERCIAL_API_KEY=

# How long a fetched forecast counts as fresh before the next request goes to Open-Meteo.
WEATHER_FORECAST_TTL_MINUTES=15

# If Open-Meteo is unreachable, a forecast up to this old can still be shown (clearly marked as old). Alerts never use it.
WEATHER_STALE_MAX_HOURS=12

# How long place-search results are remembered.
WEATHER_GEOCODE_TTL_HOURS=168

# How long to wait for Open-Meteo before giving up on one try.
WEATHER_TIMEOUT_SECONDS=8

# Extra tries after a temporary failure, with growing pauses.
WEATHER_RETRIES=2


# ======================================================================
# Database
# ======================================================================
# PostgreSQL URL (Railway sets DATABASE_URL for you). Empty = local SQLite file, fine for local testing only.
# (blank on purpose: Railway sets this when you add PostgreSQL; blank means a local SQLite file)
DATABASE_URL=

# Database connection pool size (PostgreSQL).
DB_POOL_SIZE=5

# Log every SQL statement (debugging).
DB_ECHO=false


# ======================================================================
# Telegram
# ======================================================================
# Bot token from @BotFather.
# (you must edit this)
TELEGRAM_BOT_TOKEN=edit-me

# Your numeric Telegram user id. If 0, send /claim <OWNER_PASSWORD> to the bot once to bind yourself.
TELEGRAM_OWNER_ID=0

# 'webhook' (recommended on Railway) or 'polling'. Switchable at runtime with /tgmode.
TELEGRAM_MODE=webhook

# Secret Telegram must send with every webhook call. If empty, one is generated and stored.
# (blank on purpose: generated and stored automatically)
TELEGRAM_WEBHOOK_SECRET=

# Parallel webhook connections Telegram may open (1-100).
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40

# Update types requested from Telegram, comma separated.
TELEGRAM_ALLOWED_UPDATES=message,callback_query

# Long-poll timeout in seconds (polling mode).
TELEGRAM_POLL_TIMEOUT=30

# Telegram Bot API base URL (change only for a local Bot API server).
TELEGRAM_API_BASE=https://api.telegram.org

# Discard queued updates when switching modes.
TELEGRAM_DROP_PENDING_UPDATES=false

# Message you when moderation wants approval.
TELEGRAM_NOTIFY_PENDING=true

# Cap on approval messages per minute; extras are summarised.
TELEGRAM_NOTIFY_MAX_PER_MIN=6

# Deliver reminders to Telegram.
TELEGRAM_NOTIFY_REMINDERS=true

# Message you when the stream goes live or ends, and on quota warnings.
TELEGRAM_NOTIFY_STREAM_EVENTS=true


# ======================================================================
# Google / YouTube
# ======================================================================
# OAuth client id from Google Cloud Console (YouTube Data API v3 enabled).
# (you must edit this)
GOOGLE_CLIENT_ID=edit-me

# OAuth client secret.
# (you must edit this)
GOOGLE_CLIENT_SECRET=edit-me

# OAuth redirect URI. Empty = PUBLIC_BASE_URL + /api/youtube/oauth/callback (add this exact URL in Google Cloud).
# (blank on purpose: built from PUBLIC_BASE_URL automatically)
GOOGLE_REDIRECT_URI=

# Optional: paste a refresh token here, or connect from the dashboard and it is stored for you.
# (blank on purpose: filled in when you press Connect on the Setup page)
YOUTUBE_REFRESH_TOKEN=

# Optional safety check: the Google account that should be signed in, as its channel ID (UC...) or @handle. If a different account is signed in, SavahBot reports it. It never grants any permission.
# (blank on purpose: optional safety check, not required)
YOUTUBE_MODERATOR_ACCOUNT=

# The channel whose live chat SavahBot moderates, as a channel ID (UC...) or @handle. Your own channel if you are the owner; the creator's channel if you were appointed their moderator. Not the same thing as the Google account you sign in with.
# (you must edit this)
YOUTUBE_TARGET_CHANNEL_ID=edit-me

# Deprecated: use YOUTUBE_TARGET_CHANNEL_ID. If that is empty, this value is used as the target channel.
# (blank on purpose: deprecated, use YOUTUBE_TARGET_CHANNEL_ID)
YOUTUBE_CHANNEL_ID=

# Optional: monitor this specific live video (ID or full URL). It must belong to the target channel, otherwise SavahBot refuses to attach.
# (blank on purpose: blank means find the live stream automatically)
YOUTUBE_VIDEO_ID=

# Google OAuth consent URL.
GOOGLE_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth

# Google OAuth token URL.
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# OAuth scope. force-ssl is required to read chat, delete messages and ban users.
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/youtube.force-ssl

# Reserved: API key for public (unauthenticated) reads.
# (you must edit this)
YOUTUBE_API_KEY=edit-me

# YouTube Data API base URL.
YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3

# Automatically find the target channel's live stream when no video ID is set.
YOUTUBE_AUTO_DETECT_LIVE=true

# How often to check for a live broadcast while offline (costs 1 quota unit per check).
YOUTUBE_DETECT_INTERVAL_SECONDS=180

# Typical stream length. The quota governor paces chat polling so a stream this long fits the daily budget.
YOUTUBE_EXPECTED_STREAM_HOURS=4.0

# Chat messages requested per poll (200-2000).
YOUTUBE_MAX_RESULTS=200

# After YouTube refuses an action because this account lacks permission, wait this long before trying that kind of action (or reading that chat) again.
YOUTUBE_PERMISSION_RETRY_SECONDS=300

# Reserved: use the streamList (gRPC) endpoint instead of polling.
YOUTUBE_USE_STREAMING=false

# Longest message YouTube chat accepts; bot replies are trimmed to this.
YOUTUBE_MESSAGE_MAX_LENGTH=200

# Store the chat history found on connect (not moderated).
YOUTUBE_BACKFILL_ON_CONNECT=true


# ======================================================================
# YouTube quota
# ======================================================================
# Daily quota units available to your Google Cloud project.
YT_DAILY_QUOTA=10000

# Timezone where YouTube resets quota (midnight Pacific).
YT_QUOTA_RESET_TZ=America/Los_Angeles

# Quota cost: read chat messages. Verify against the current YouTube docs.
YT_COST_CHAT_LIST=5

# Quota cost: send a chat message.
YT_COST_CHAT_INSERT=20

# Quota cost: delete a chat message.
YT_COST_CHAT_DELETE=20

# Quota cost: ban / time out a user.
YT_COST_BAN=200

# Quota cost: look up your live broadcast.
YT_COST_BROADCAST_LIST=1

# Quota cost: look up a video.
YT_COST_VIDEO_LIST=1

# Quota cost: look up a channel (the signed-in account, or a @handle).
YT_COST_CHANNEL_LIST=1

# Quota cost: search for a channel's live stream. Verify against the current YouTube docs.
YT_COST_SEARCH=100

# Share of the daily quota that searching for another channel's live stream may use.
YT_DETECT_BUDGET_FRACTION=0.1

# How often to search for a live stream on a channel you do not own while it is offline. Searching is expensive, so it is also capped by YT_DETECT_BUDGET_FRACTION. Set YOUTUBE_VIDEO_ID to avoid searching.
YOUTUBE_TARGET_DETECT_INTERVAL_SECONDS=900

# Quota cost: check recent subscribers. Verify against the current YouTube docs.
YT_COST_SUBSCRIPTION_LIST=1

# Tell me (bell, push, Telegram per the category settings) about new members, Super Chats, Super Stickers and membership gifts.
YT_EVENTS_NOTIFY=true

# Post a thank-you in chat for members, Super Chats and gifts. Off by default: it costs YouTube quota for every message.
YT_EVENTS_THANK=false

# Thank-you for a new member. $(user) and $(count) are filled in; your own variables work too.
YT_EVENTS_MSG_MEMBER=Welcome to the members, $(user)! 💚

# Thank-you for a Super Chat or Super Sticker. $(user) and $(amount) are filled in.
YT_EVENTS_MSG_SUPERCHAT=Thank you $(user) for the $(amount)!

# Thank-you for membership gifts. $(user) and $(count) are filled in.
YT_EVENTS_MSG_GIFT=Thank you $(user) for gifting $(count) memberships!

# Look for new subscribers while you are live. Best effort: YouTube only lists subscribers who made their subscription public.
YT_SUBS_ENABLED=true

# How often to check for new subscribers, in minutes (5 to 120). Each check costs about 1 quota unit.
YT_SUBS_MINUTES=10

# Post a thank-you in chat for a new subscriber you can see by name.
YT_SUBS_THANK=false

# Thank-you for a new subscriber. $(user) is filled in.
YT_SUBS_MSG=Thanks for subscribing, $(user)! 🎉

# Alert me each time the subscriber count passes a multiple of this. 0 turns milestones off.
YT_SUBS_MILESTONE_STEP=100

# Track likes and people watching while you are live.
YT_LIVE_ENABLED=true

# How often to refresh likes and viewers, in seconds (30 to 600). Each refresh costs about 1 quota unit.
YT_LIVE_SECONDS=60

# Alert me each time likes pass a multiple of this. 0 turns it off.
YT_LIVE_LIKES_STEP=100

# Alert me each time viewers pass a multiple of this for the first time in a stream. 0 turns it off.
YT_LIVE_VIEWERS_STEP=50

# Quota cost: list moderators.
YT_COST_MODERATOR_LIST=50

# Share of the daily quota the bot may spend reading chat (the rest is kept for actions).
YT_READ_BUDGET_FRACTION=0.6

# Never poll chat faster than this.
YT_MIN_POLL_SECONDS=5.0

# Never wait longer than this between polls.
YT_MAX_POLL_SECONDS=60.0

# Warn on Telegram when this share of the daily quota is used.
YT_QUOTA_WARN_FRACTION=0.8


# ======================================================================
# Moderation
# ======================================================================
# 'off' (no checks), 'suggest' (ask you to approve actions) or 'auto' (act by itself). Switchable at runtime.
MOD_MODE=suggest

# Actions allowed to run without approval in auto mode. Bans always wait for you unless 'ban' is listed.
MOD_AUTO_ACTIONS=delete,timeout

# Chat levels that are never moderated.
MOD_EXEMPT_LEVELS=owner,mod,bot

# Regulars are never moderated.
MOD_EXEMPT_REGULARS=true

# Paying members are never moderated.
MOD_EXEMPT_MEMBERS=false

# Score at which a message is flagged (logged only).
MOD_SCORE_FLAG=30

# Score at which a message is deleted.
MOD_SCORE_DELETE=55

# Score at which the author is timed out.
MOD_SCORE_TIMEOUT=90

# Score at which the author is banned.
MOD_SCORE_BAN=100

# Timeout seconds for the first, second, third... timeout. Each extra strike climbs one rung.
MOD_TIMEOUT_LADDER=60,300,900,3600

# Strikes expire after this many minutes.
MOD_STRIKE_DECAY_MINUTES=60

# Strikes before a delete escalates to a timeout.
MOD_STRIKES_TO_TIMEOUT=2

# Strikes before a timeout escalates to a ban.
MOD_STRIKES_TO_BAN=4

# Allow escalation to bans (bans cost the most YouTube quota).
MOD_ALLOW_BAN_ESCALATION=true

# The harshest action the bot may ever take: 'delete' (messages only, nobody is timed out or banned), 'timeout' or 'ban'. Lower actions are unaffected.
MOD_MAX_PUNISHMENT=ban

# Comma-separated names or channel ids that are never timed out or banned. Their bad messages are still deleted.
MOD_NEVER_PUNISH=

# Cap the harshest action for one kind of trigger, as name:action pairs, e.g. 'link:delete,caps:delete,raid:ban'. Names are the signal names shown on each moderation card.
MOD_REASON_CAPS=

# Most automatic timeouts and bans per day. After that the bot only deletes. 0 means no limit.
MOD_AUTO_PUNISH_DAILY_CAP=0

# Automatically lift permanent bans the bot made by itself after this many hours (each lift costs YouTube quota). 0 means never.
MOD_SECOND_CHANCE_HOURS=0

# Unanswered approval requests expire after this long, so stale bans are never approved by accident.
MOD_PENDING_TTL_MINUTES=30

# Messages deleted when one grouped action is approved (protects quota).
MOD_MAX_DELETES_PER_ACTION=10

# Do not repeat a timeout/ban on the same user within this window.
MOD_ACTION_COOLDOWN_SECONDS=60

# Also message you for flag-level events.
MOD_NOTIFY_ON_FLAG=false

# A chatter is 'new' for this long after their first message.
MOD_NEW_CHATTER_SECONDS=120

# Extra score for a new chatter who already triggered another signal.
MOD_NEW_CHATTER_WEIGHT=15

# Detect shouting (mostly capital letters).
MOD_CAPS_ENABLED=true

# Messages shorter than this are never caps-checked.
MOD_CAPS_MIN_LENGTH=20

# Share of letters that must be capitals to trigger.
MOD_CAPS_RATIO=0.7

# Score added by the caps signal.
MOD_CAPS_WEIGHT=30

# Detect symbol spam.
MOD_SYMBOLS_ENABLED=true

# Messages shorter than this are never symbol-checked.
MOD_SYMBOLS_MIN_LENGTH=10

# Share of non-alphanumeric characters that triggers.
MOD_SYMBOLS_RATIO=0.5

# Score added by the symbol signal.
MOD_SYMBOLS_WEIGHT=25

# Detect emote/emoji floods.
MOD_EMOTES_ENABLED=true

# Emotes allowed in one message.
MOD_EMOTES_MAX=8

# Score added by the emote signal.
MOD_EMOTES_WEIGHT=20

# Detect links (including 'site dot com' disguises).
MOD_LINKS_ENABLED=true

# Score added by the link signal.
MOD_LINKS_WEIGHT=45

# Domains that are always allowed, comma separated.
MOD_ALLOWED_DOMAINS=youtube.com,youtu.be

# How long !permit lets someone post links.
MOD_PERMIT_SECONDS=60

# Detect repeated characters and words.
MOD_REPEAT_ENABLED=true

# Same character in a row that triggers.
MOD_REPEAT_CHAR_RUN=10

# Share of repeated words (in messages of 6+ words) that triggers.
MOD_REPEAT_WORD_RATIO=0.6

# Score added by the repetition signal.
MOD_REPEAT_WEIGHT=25

# Detect overly long messages.
MOD_LENGTH_ENABLED=true

# Longest normal message.
MOD_MAX_LENGTH=300

# Score added by the length signal.
MOD_LENGTH_WEIGHT=15

# Match the banned-phrase list (handles leetspeak, look-alike letters, spacing).
MOD_BLACKLIST_ENABLED=true

# Default score for a banned phrase (each phrase can override it).
MOD_BLACKLIST_WEIGHT=70

# Limit how fast one user may post.
MOD_RATE_ENABLED=true

# Messages allowed per window.
MOD_RATE_MAX_MESSAGES=5

# Rate-limit window length.
MOD_RATE_WINDOW_SECONDS=10

# Messages allowed per window for new chatters.
MOD_RATE_NEW_CHATTER_MAX=3

# Score added by the rate signal.
MOD_RATE_WEIGHT=40

# Detect the same user repeating a message.
MOD_DUP_ENABLED=true

# Window in which a repeat counts.
MOD_DUP_WINDOW_SECONDS=60

# Score added by the duplicate signal (60% for the first repeat).
MOD_DUP_WEIGHT=35

# Detect copy-paste raids: near-identical messages from several accounts.
MOD_SIM_ENABLED=true

# Window for cross-account similarity.
MOD_SIM_WINDOW_SECONDS=120

# Max SimHash bit distance (of 64) to call two messages similar. Lower = stricter.
MOD_SIM_MAX_DISTANCE=8

# Distinct accounts posting similar text before it counts as a raid.
MOD_SIM_MIN_ACCOUNTS=4

# Shortest message considered for similarity.
MOD_SIM_MIN_LENGTH=12

# Score added by the raid signal.
MOD_SIM_WEIGHT=45

# Detect bots posting at machine-regular intervals.
MOD_INTERVAL_ENABLED=true

# Messages needed before timing is judged.
MOD_INTERVAL_MIN_MESSAGES=5

# Timing variation (std/mean) below this looks automated.
MOD_INTERVAL_MAX_CV=0.15

# Only judge users whose average gap is under this many seconds.
MOD_INTERVAL_MAX_MEAN_GAP=120.0

# Score added by the timing signal.
MOD_INTERVAL_WEIGHT=30


# ======================================================================
# Intelligence
# ======================================================================
# Master switch for the intelligence layer (phrase packs, typo matching, link intelligence, scam intent, statistics). Off = the bot behaves exactly as in 1.1.5.
INTEL_ENABLED=true

# The most score the intelligence layer can add to one message on its own. Keeps it from banning anyone by itself.
INTEL_MAX_WEIGHT=60

# Scam phrases and scam-intent scoring: off, shadow (logged, never scored) or live.
INTEL_SCAM_MODE=live

# Spam and promotion phrases: off, shadow or live.
INTEL_SPAM_MODE=live

# Profanity and insults: off, shadow or live. Shadow by default so you can review what it would catch first.
INTEL_ABUSE_MODE=shadow

# Threats and harassment (death wishes, doxxing, swatting): off, shadow or live.
INTEL_HARASSMENT_MODE=live

# Typo and disguise matching of blocked and known-bad phrases: off, shadow or live.
INTEL_TYPO_MODE=live

# Link intelligence (look-alike domains, shorteners, threat lists): off, shadow or live.
INTEL_LINK_RISK_MODE=live

# Impersonation guard (copied or staff-like account names, 'I am the admin'): off, shadow or live.
INTEL_IMPERSONATION_MODE=live

# Text tricks (zalgo, hidden characters, mixed alphabets, symbol art): off, shadow or live.
INTEL_OBFUSCATION_MODE=live

# Bot-like account names: off, shadow or live.
INTEL_BOT_LIKE_MODE=shadow

# Naive Bayes spam-likeness: off, shadow or live.
INTEL_INTENT_MODE=shadow

# Similarity to known spam messages (BM25): off, shadow or live.
INTEL_KNOWN_SPAM_MODE=shadow

# Raid wave tracker: off, shadow or live.
INTEL_RAID_WAVE_MODE=live

# Strength multiplier for the scam detector (0.5 = half as strong, 2 = twice).
INTEL_SCAM_SCALE=1.0

# Strength multiplier for the spam detector.
INTEL_SPAM_SCALE=1.0

# Strength multiplier for the abuse detector.
INTEL_ABUSE_SCALE=1.0

# Strength multiplier for the threats and harassment detector.
INTEL_HARASSMENT_SCALE=1.0

# Strength multiplier for typo matching.
INTEL_TYPO_SCALE=1.0

# Strength multiplier for link intelligence.
INTEL_LINK_RISK_SCALE=1.0

# Strength multiplier for the impersonation guard.
INTEL_IMPERSONATION_SCALE=1.0

# Strength multiplier for text-trick detection.
INTEL_OBFUSCATION_SCALE=1.0

# Strength multiplier for bot-like accounts.
INTEL_BOT_LIKE_SCALE=1.0

# Strength multiplier for the Naive Bayes detector.
INTEL_INTENT_SCALE=1.0

# Strength multiplier for known-spam similarity.
INTEL_KNOWN_SPAM_SCALE=1.0

# Strength multiplier for the raid wave bonus.
INTEL_RAID_WAVE_SCALE=1.0

# Understand context: a question about a scam, or a warning to others, scores lower than the scam itself.
INTEL_CONTEXT_ENABLED=true

# Use the safe phrases (gaming talk such as 'kill streak') to stop rules firing on normal chat.
INTEL_SAFE_ENABLED=true

# Which language packs are active, comma separated: en, sw (Swahili), sheng.
INTEL_LANGUAGES=en,sw,sheng

# Names the impersonation guard protects, comma separated (your channel name, your moderators). The demo channel name is added automatically.
INTEL_PROTECTED_NAMES=

# Your own websites, comma separated. Links that look almost like them are flagged as look-alikes, and links to them are never treated as risky.
INTEL_PROTECTED_DOMAINS=

# Messages shorter than this many words are not scored by the statistical detectors.
INTEL_INTENT_MIN_TOKENS=4

# A raid wave starts when this many brand-new accounts speak within the window below.
INTEL_WAVE_ACCOUNTS=6

# Window for counting new accounts toward a raid wave.
INTEL_WAVE_WINDOW_SECONDS=30

# How long a raid wave stays active once detected.
INTEL_WAVE_DURATION_SECONDS=180

# Score added to suspicious messages from new accounts during a raid wave.
INTEL_WAVE_WEIGHT=15

# What the bot does with what it learns from your approve and reject decisions: off, suggest (you decide) or auto (applies the confident ones, every change is logged and reversible).
INTEL_LEARNING_MODE=suggest

# The learned model only influences scoring once it has at least this many lessons (spam and fine together). Stops a few early decisions from swinging the bot.
INTEL_LEARN_MIN_LESSONS=10

# Also learn from simulated (demo) decisions. Off by default so test data never teaches the bot.
INTEL_LEARN_FROM_DEMO=false

# Learn that ordinary messages from regulars, members and mods are fine (a few per minute at most).
INTEL_LEARN_TRUSTED_HAM=true

# Most lessons kept. When there are more, the oldest are forgotten first.
INTEL_EXAMPLE_CAP=5000

# Delete lessons older than this many days. 0 keeps them until you forget them or the limit above is reached.
INTEL_LESSON_RETENTION_DAYS=0

# Refresh the live data feeds (public phishing and malware domain lists) in the background.
INTEL_FEEDS_ENABLED=true

# Minimum hours between refreshes of the same feed. Never lower than 1.
INTEL_FEED_INTERVAL_HOURS=24

# Most domains kept from any one feed.
INTEL_FEED_MAX_ENTRIES=15000

# Largest download accepted from a feed.
INTEL_FEED_MAX_BYTES=6000000

# Wait this long after boot before the first feed refresh, so start-up stays fast.
INTEL_FEED_STARTUP_DELAY_SECONDS=120


# ======================================================================
# Commands
# ======================================================================
# Character(s) that start a chat command.
COMMAND_PREFIX=!

# Default global cooldown (seconds) for new commands.
COMMAND_DEFAULT_COOLDOWN=5

# Default per-user cooldown (seconds) for new commands.
COMMAND_USER_COOLDOWN=10

# Replies are trimmed to this many characters.
COMMAND_MAX_RESPONSE_LENGTH=200

# Maximum nesting of $(variables).
COMMAND_MAX_RENDER_DEPTH=6

# Maximum $(variables) evaluated per reply.
COMMAND_MAX_EXPANSIONS=25

# Run auto-replies: the bot answers when a viewer sends a configured phrase or word.
TRIGGERS_ENABLED=true

# Default global cooldown (seconds) for new auto-replies.
TRIGGER_DEFAULT_COOLDOWN=30

# Default per-user cooldown (seconds) for new auto-replies.
TRIGGER_USER_COOLDOWN=60

# Create starter commands, timers, quotes and banned phrases on first boot.
COMMAND_SEED_DEFAULTS=true

# Allow $(urlfetch ...) in commands (owner-created commands only).
URLFETCH_ENABLED=true

# Timeout for $(urlfetch ...).
URLFETCH_TIMEOUT_SECONDS=4.0

# Maximum bytes read by $(urlfetch ...).
URLFETCH_MAX_BYTES=2000

# If set, urlfetch may only call these hosts (comma separated).
# (blank on purpose: blank means any public host is allowed (private networks are always blocked))
URLFETCH_ALLOWED_HOSTS=

# Block urlfetch calls to private/internal addresses (SSRF protection).
URLFETCH_BLOCK_PRIVATE=true


# ======================================================================
# Scheduler
# ======================================================================
# Run chat timers.
TIMERS_ENABLED=true

# Run reminders.
REMINDERS_ENABLED=true

# How often timers and reminders are checked.
SCHEDULER_TICK_SECONDS=3


# ======================================================================
# Demo
# ======================================================================
# Allow demo mode.
DEMO_ENABLED=true

# Start the ambient demo chat when the bot is in demo mode.
DEMO_AUTOSTART=true

# Ambient demo chat speed.
DEMO_MESSAGES_PER_MINUTE=30

# Channel name shown in demo mode.
DEMO_CHANNEL_NAME=SavahDemo

# Number of simulated viewers.
DEMO_CHATTER_COUNT=20

# Chance (0-1) that an ambient demo message is spam.
DEMO_SPAM_PROBABILITY=0.06

# Random seed (0 = different every run).
DEMO_SEED=0


# ======================================================================
# Redis (optional)
# ======================================================================
# Redis address (redis:// or rediss://). Blank = everything stays in memory. Turns on: moderation memory that survives restarts, shared login lockouts, live events across instances, one leader instance, a short dashboard cache, and restart-proof cooldowns.
# (you must edit this)
REDIS_URL=edit-me

# Prefix for every key this bot writes, so one Redis can be shared with other apps.
REDIS_PREFIX=savahbot

# How long to wait for Redis before carrying on in memory.
REDIS_TIMEOUT_SECONDS=3

# How often the moderation memory is saved to Redis (0 = never). It is also saved when the bot shuts down.
REDIS_SNAPSHOT_SECONDS=10

# If the leader instance disappears, another one takes over after about this many seconds.
REDIS_LEADER_TTL_SECONDS=30

# With Redis on, how long heavy dashboard queries (such as Insights) are reused. 0 = no caching.
SHARED_CACHE_SECONDS=15


# ======================================================================
# Reserved (future features, unused today)
# ======================================================================
# Reserved: Twitch application client id.
# (unused today; edit only when that feature ships)
TWITCH_CLIENT_ID=edit-me

# Reserved: Twitch application client secret.
# (unused today; edit only when that feature ships)
TWITCH_CLIENT_SECRET=edit-me

# Reserved: Twitch channel name.
# (unused today; edit only when that feature ships)
TWITCH_CHANNEL=edit-me

# Reserved: Twitch chat OAuth token.
# (unused today; edit only when that feature ships)
TWITCH_BOT_TOKEN=edit-me

# Reserved: Kick application client id.
# (unused today; edit only when that feature ships)
KICK_CLIENT_ID=edit-me

# Reserved: Kick application client secret.
# (unused today; edit only when that feature ships)
KICK_CLIENT_SECRET=edit-me

# Reserved: Discord bot token.
# (unused today; edit only when that feature ships)
DISCORD_BOT_TOKEN=edit-me

# Reserved: Discord webhook for alerts.
# (unused today; edit only when that feature ships)
DISCORD_WEBHOOK_URL=edit-me

# Reserved: Sentry error reporting DSN.
# (unused today; edit only when that feature ships)
SENTRY_DSN=edit-me

# Reserved: SMTP host for email alerts.
# (unused today; edit only when that feature ships)
SMTP_HOST=edit-me

# Reserved: SMTP port.
SMTP_PORT=587

# Reserved: SMTP username.
# (unused today; edit only when that feature ships)
SMTP_USER=edit-me

# Reserved: SMTP password.
# (unused today; edit only when that feature ships)
SMTP_PASSWORD=edit-me

# Reserved: sender address for email alerts.
# (unused today; edit only when that feature ships)
SMTP_FROM=edit-me

# Reserved: POST moderation events to this URL.
# (unused today; edit only when that feature ships)
OUTBOUND_WEBHOOK_URL=edit-me

# Reserved: HMAC secret for outbound webhooks.
# (unused today; edit only when that feature ships)
OUTBOUND_WEBHOOK_SECRET=edit-me

# Reserved: AI features (off by design for now).
AI_ENABLED=false

# Reserved: AI provider name.
# (blank on purpose: AI is not used in this version)
AI_PROVIDER=

# Reserved: AI provider API key.
# (unused today; edit only when that feature ships)
AI_API_KEY=edit-me

# Reserved: AI model name.
# (blank on purpose: AI is not used in this version)
AI_MODEL=
