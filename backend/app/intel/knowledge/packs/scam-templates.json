 "title": "Scam message shapes",
 "category": "scams",
 "kind": "templates",
 "description": "Not word lists but shapes: money doubling, prizes, urgency, contact lures, fake support, reversal tricks. One hint alone is weak; several together are a scam.",
 "data": {
  "groups": [
   {
    "id": "doubling",
    "title": "Send some, get double back",
    "w": 80,
    "strong": true,
    "note": "The oldest crypto con: pay first, receive more.",
    "patterns": [
     "(?:send|deposit|transfer|invest)\\s+(?:me\\s+)?[\\$£€]?\\d[\\d,.]*\\s*(?:btc|eth|usdt|bnb|sol|doge|ksh|kes|usd)?\\b.{0,60}?(?:get|receive|return|back|earn).{0,25}?(?:double|2x|twice|x2)",
     "\\b(?:double|2x|triple|3x|10x)\\b.{0,25}\\b(?:your|ur)\\b.{0,20}\\b(?:money|crypto|bitcoin|btc|eth|usdt|investment|mpesa|m-pesa)",
     "\\b(?:send|pay)\\b.{0,30}\\b(?:and|then)\\b.{0,15}\\b(?:get|receive)\\b.{0,15}\\b(?:back|double|x2|2x)"
    ]
   },
   {
    "id": "prize",
    "title": "You have won",
    "w": 55,
    "note": "Prize and winner announcements nobody entered.",
    "patterns": [
     "\\byou(?:'ve|\\s+have|\\s+are|\\s+were)?\\s+(?:been\\s+)?(?:won|win|winner|selected|chosen)\\b",
     "\\bcongrat\\w*\\b.{0,30}\\b(?:won|winner|selected|prize|gift)",
     "\\bclaim\\b.{0,15}\\b(?:your|ur|the)\\b.{0,15}\\b(?:prize|gift|reward|bonus|winnings|airdrop|nitro|robux)",
     "\\b(?:umeshinda|umechaguliwa)\\b"
    ]
   },
   {
    "id": "urgency",
    "title": "Pressure to act now",
    "w": 25,
    "note": "Limited slots, last chance, only for the first few.",
    "patterns": [
     "\\b(?:hurry|limited\\s+(?:time|slots|spots|offer)|only\\s+\\d+\\s+(?:left|spots|slots)|act\\s+now|last\\s+chance|expires?\\s+(?:soon|today|in)|first\\s+\\d+\\s+(?:people|viewers|users|winners))\\b",
     "\\bbefore\\s+it(?:'s|\\s+is)\\s+too\\s+late\\b",
     "\\b(?:sasa\\s+hivi|leo\\s+tu|nafasi\\s+chache)\\b"
    ]
   },
   {
    "id": "contact",
    "title": "Move to DMs, WhatsApp or Telegram",
    "w": 35,
    "note": "The real scam happens off-chat.",
    "patterns": [
     "\\b(?:dm|inbox|pm)\\s+me\\b",
     "\\b(?:whats?app|telegram|signal|snap(?:chat)?)\\b.{0,15}(?:\\+?\\d[\\d\\s-]{7,}|\\bme\\b|@\\w+|link)",
     "(?:t\\.me|wa\\.me|chat\\.whatsapp\\.com)/",
     "\\b(?:text|call|contact|message|chat)\\s+me\\s+(?:on|at|via)\\b"
    ]
   },
   {
    "id": "phone",
    "title": "A phone number in chat",
    "w": 30,
    "note": "Numbers of seven or more digits, often with a country code.",
    "patterns": [
     "(?<!\\d)\\+?\\d{1,3}[\\s-]?\\d{3}[\\s-]?\\d{3}[\\s-]?\\d{3,4}(?!\\d)",
     "(?<!\\d)0[17]\\d{2}[\\s-]?\\d{3}[\\s-]?\\d{3}(?!\\d)"
    ]
   },
   {
    "id": "authority",
    "title": "Pretends to be staff or a brand",
    "w": 40,
    "note": "'Official support', 'YouTube team', 'I am the admin'.",
    "patterns": [
     "\\b(?:official|verified)\\b.{0,15}\\b(?:support|team|staff|admin|moderator|agent)\\b",
     "\\b(?:youtube|google|safaricom|paypal|binance|discord|steam|roblox)\\b.{0,12}\\b(?:support|team|staff|security|customer\\s*care|help\\s*desk)\\b",
     "\\bi\\s+am\\s+(?:the\\s+)?(?:admin|owner|mod|moderator|support|manager)\\b"
    ]
   },
   {
    "id": "threat",
    "title": "Threat to your account",
    "w": 45,
    "note": "Suspended, terminated, copyright strike, 'verify now'.",
    "patterns": [
     "\\b(?:your|ur)\\s+(?:account|channel|video|page|sim|line)\\b.{0,25}\\b(?:suspended|terminated|deleted|banned|blocked|disabled|hacked|compromised|locked|restricted)\\b",
     "\\bcopyright\\b.{0,20}\\b(?:strike|claim|violation|notice)\\b",
     "\\b(?:verify|confirm)\\b.{0,20}\\b(?:account|identity|channel|number)\\b"
    ]
   },
   {
    "id": "credentials",
    "title": "Asks for a password or code",
    "w": 70,
    "strong": true,
    "note": "No real support asks for a PIN, OTP or seed phrase.",
    "patterns": [
     "\\b(?:send|give|share|tell|enter)\\b.{0,15}\\b(?:your|ur|me\\s+your|me\\s+ur)\\b.{0,10}\\b(?:password|pin|otp|code|seed\\s*phrase|private\\s*key|recovery\\s*phrase|login)\\b",
     "\\bseed\\s*phrase\\b",
     "\\b(?:otp|one\\s*time\\s*(?:pin|password))\\b.{0,20}\\b(?:send|share|give|tell)\\b"
    ]
   },
   {
    "id": "mpesa-reversal",
    "title": "'Sent by mistake, please reverse'",
    "w": 65,
    "strong": true,
    "note": "The fake M-Pesa reversal and 'tuma kwa hii number' tricks.",
    "patterns": [
     "\\b(?:sent|send|nimetuma|nimekutumia)\\b.{0,30}\\b(?:by\\s+mistake|wrong\\s+number|kimakosa|mistakenly|erroneously)\\b",
     "\\b(?:reverse|return|rudisha|refund)\\b.{0,25}\\b(?:money|pesa|ksh|kes|mpesa|m-pesa|transaction|hela)\\b",
     "\\btuma\\s+kwa\\s+(?:hii\\s+)?(?:number|namba)\\b"
    ]
   },
   {
    "id": "money-ask",
    "title": "Asks you to send money",
    "w": 30,
    "note": "Includes advance-fee wording: pay a fee to unlock a prize or loan.",
    "patterns": [
     "\\b(?:send|tuma|nitumie)\\b.{0,20}\\b(?:money|pesa|mpesa|m-pesa|ksh|kes|cash|funds|btc|crypto|usdt)\\b",
     "\\b(?:pay|deposit)\\b.{0,15}\\b(?:fee|registration|activation|processing|clearance)\\b"
    ]
   },
   {
    "id": "get-rich",
    "title": "Easy money promise",
    "w": 40,
    "note": "Daily earnings, guaranteed profit, 'pata pesa haraka'.",
    "patterns": [
     "\\b(?:earn|make|get|pata|kupata)\\b.{0,15}(?:[\\$£€]|ksh|kes|usd)\\s?\\d[\\d,]*.{0,15}\\b(?:daily|a\\s+day|per\\s+day|weekly|every\\s+day|kila\\s+siku|hourly|per\\s+hour|in\\s+\\d+\\s+(?:minutes|hours|days))",
     "\\b(?:guaranteed|risk[\\s-]?free|100%)\\b.{0,15}\\b(?:profit|returns?|income|win|payout)",
     "\\b(?:passive|easy|fast|quick)\\s+(?:income|money|cash|profit)\\b",
     "\\b(?:pata|kupata)\\s+pesa\\s+(?:haraka|mtandaoni|bure)\\b"
    ]
   },
   {
    "id": "click-link",
    "title": "Click the link",
    "w": 30,
    "note": "'Link in bio', 'click here', 'bonyeza hapa'.",
    "patterns": [
     "\\b(?:click|tap|open|visit|bonyeza)\\b.{0,20}\\b(?:link|here|below|bio|profile|description|hapa|kiungo)\\b",
     "\\blink\\s+in\\s+(?:my\\s+)?(?:bio|profile|description|comments?)\\b"
    ]
   },
   {
    "id": "free-stuff",
    "title": "Free things",
    "w": 35,
    "note": "Free Robux, Nitro, skins, followers, bundles, airtime.",
    "patterns": [
     "\\bfree\\b.{0,10}\\b(?:robux|vbucks|v-bucks|nitro|skins?|gift\\s*card|iphone|followers|subs|subscribers|views|bundles?|airtime|data|crypto|bitcoin|money|cash)\\b",
     "\\b(?:bure|bila\\s+malipo|bila\\s+kulipa)\\b"
    ]
   },
   {
    "id": "qr",
    "title": "Scan the QR code",
    "w": 35,
    "note": "Streamjacked giveaways show a wallet QR on screen.",
    "patterns": [
     "\\bscan\\b.{0,15}\\bqr\\b",
     "\\bqr\\s*code\\b.{0,25}\\b(?:giveaway|win|claim|send|wallet|pay)"
    ]
   },
   {
    "id": "job-lure",
    "title": "Fake job groups",
    "w": 40,
    "note": "Online-job lures that lead to WhatsApp or Telegram groups.",
    "patterns": [
     "\\b(?:online|remote|home|nyumbani)\\s+(?:jobs?|work|kazi)\\b.{0,40}\\b(?:whats?app|telegram|apply|join|dm|inbox)",
     "\\b(?:kazi|jobs?|vacanc\\w+)\\b.{0,25}\\b(?:whats?app|telegram|group)\\b",
     "\\b(?:join|jiunge)\\b.{0,20}\\b(?:whats?app|telegram)\\b.{0,10}\\b(?:group|channel|kundi)"
    ]
   }
  ]
 }
}
