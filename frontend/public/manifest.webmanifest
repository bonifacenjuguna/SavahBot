{
  "id": "/",
  "name": "SavahBot",
  "short_name": "SavahBot",
  "description": "Moderation and utility dashboard for YouTube live chat",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#131c33",
  "theme_color": "#131c33",
  "categories": [
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Moderation",
      "short_name": "Moderation",
      "description": "Requests waiting for a decision",
      "url": "/moderation",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Desk",
      "short_name": "Desk",
      "description": "Live chat and status",
      "url": "/desk",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Notebook",
      "short_name": "Notebook",
      "description": "Notes and reminders",
      "url": "/notebook",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Insights",
      "short_name": "Insights",
      "description": "Charts of chat and moderation",
      "url": "/insights",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Commands",
      "short_name": "Commands",
      "description": "Chat commands and timers",
      "url": "/commands",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Notifications",
      "short_name": "Notifications",
      "description": "Push, bell and quiet hours",
      "url": "/notifications",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "orientation": "any",
  "dir": "ltr",
  "prefer_related_applications": false,
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+savahbot",
      "url": "/open?u=%s"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desk-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The Desk: live chat, status and requests waiting"
    },
    {
      "src": "/screenshots/moderation-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Moderation: approve or reject with a clear reason"
    },
    {
      "src": "/screenshots/insights-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Insights: charts of chat and moderation"
    },
    {
      "src": "/screenshots/desk-narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The Desk on a phone"
    },
    {
      "src": "/screenshots/moderation-narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Decide requests from your pocket"
    },
    {
      "src": "/screenshots/notebook-narrow.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Notes and reminders"
    }
  ]
}
